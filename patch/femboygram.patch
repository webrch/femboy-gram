+package org.telegram.femboy;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Paint;
+import android.util.SparseIntArray;
+import android.view.View;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.DispatchQueue;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.UserObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.FemboyPetView;
+import org.telegram.ui.FemboyStreakDrawable;
+
+import java.util.ArrayList;
+import java.util.Calendar;
+import java.util.Map;
+import java.util.TimeZone;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Серии в личке: день засчитан, когда за местные сутки написали оба. Серия это
+ * непрерывный отрезок засчитанных дней, который кончается сегодня или вчера.
+ *
+ * Хранится отрезок (начало и конец) и флаги за последние три недели. Так серия
+ * в год не требует хранить год дней. Всё меняется на своей очереди, имена в
+ * списках только читают готовое.
+ */
+public final class FemboyStreaks implements NotificationCenter.NotificationCenterDelegate {
+
+    /** С какой серии видно огонёк и яйцо. */
+    public static final int MIN_SHOWN = 3;
+
+    public static final int ME = 1;
+    public static final int THEM = 2;
+    private static final int BOTH = ME | THEM;
+
+    /** Сколько последних дней держим с флагами. */
+    private static final int KEEP_DAYS = 21;
+    private static final int BACKFILL_DIALOGS = 60;
+    private static final int BACKFILL_DAYS = 120;
+
+    private static final String KEY_BACKFILL = "_bf";
+
+    private FemboyStreaks() {}
+
+    private static final FemboyStreaks INSTANCE = new FemboyStreaks();
+    private static final DispatchQueue queue = new DispatchQueue("femboyStreaks");
+
+    @SuppressWarnings("unchecked")
+    private static final ConcurrentHashMap<Long, Entry>[] entries = new ConcurrentHashMap[UserConfig.MAX_ACCOUNT_COUNT];
+    private static final boolean[] started = new boolean[UserConfig.MAX_ACCOUNT_COUNT];
+    private static final int[] backfillChecked = new int[UserConfig.MAX_ACCOUNT_COUNT];
+    private static final boolean[] notifyPending = new boolean[UserConfig.MAX_ACCOUNT_COUNT];
+
+    static {
+        for (int a = 0; a < entries.length; a++) entries[a] = new ConcurrentHashMap<>();
+    }
+
+    // ---------------------------------------------------------------- настройки
+
+    public static boolean flamesEnabled() {
+        return FemboyConfig.prefs().getBoolean("streak_flames", true);
+    }
+
+    public static void setFlamesEnabled(boolean on) {
+        FemboyConfig.prefs().edit().putBoolean("streak_flames", on).apply();
+        notifyAllAccounts();
+    }
+
+    public static boolean petEnabled() {
+        return FemboyConfig.prefs().getBoolean("streak_pet", true);
+    }
+
+    public static void setPetEnabled(boolean on) {
+        FemboyConfig.prefs().edit().putBoolean("streak_pet", on).apply();
+    }
+
+    // ---------------------------------------------------------------- дни
+
+    private static volatile int cachedToday;
+    private static volatile long todayEndsAt;
+
+    /** Номер местного дня. */
+    public static int today() {
+        final long now = System.currentTimeMillis();
+        if (now >= todayEndsAt) {
+            cachedToday = dayOfMillis(now);
+            final Calendar c = Calendar.getInstance();
+            c.setTimeInMillis(now);
+            c.set(Calendar.HOUR_OF_DAY, 0);
+            c.set(Calendar.MINUTE, 0);
+            c.set(Calendar.SECOND, 0);
+            c.set(Calendar.MILLISECOND, 0);
+            c.add(Calendar.DAY_OF_MONTH, 1);
+            todayEndsAt = c.getTimeInMillis();
+        }
+        return cachedToday;
+    }
+
+    private static int dayOfMillis(long ms) {
+        final long local = ms + TimeZone.getDefault().getOffset(ms);
+        return (int) (local >= 0 ? local / 86400000L : (local - 86399999L) / 86400000L);
+    }
+
+    private static int dayOf(int unixSeconds) {
+        return dayOfMillis(unixSeconds * 1000L);
+    }
+
+    // ---------------------------------------------------------------- запись одного диалога
+
+    private static final class Entry {
+        int runStart, runEnd;
+        int broken;
+        final SparseIntArray days = new SparseIntArray();
+        String petName;
+        int petDay;
+
+        /** Отметить сторону за день. true, если что-то поменялось. */
+        boolean mark(int day, int flag, int today) {
+            if (day <= broken || day > today || day < today - KEEP_DAYS) return false;
+            final int was = days.get(day);
+            final int now = was | flag;
+            if (now == was) return false;
+            days.put(day, now);
+            if (now == BOTH) counted(day);
+            return true;
+        }
+
+        void counted(int day) {
+            if (day <= broken) return;
+            if (runEnd == 0 || day > runEnd + 1) {
+                runStart = runEnd = day;
+            } else if (day == runEnd + 1) {
+                runEnd = day;
+            } else if (day == runStart - 1) {
+                runStart = day;
+            }
+            chain();
+        }
+
+        /** Дотянуть отрезок через уже засчитанные соседние дни. */
+        void chain() {
+            if (runEnd == 0) return;
+            while (days.get(runStart - 1) == BOTH && runStart - 1 > broken) runStart--;
+            while (days.get(runEnd + 1) == BOTH) runEnd++;
+            if (runStart <= broken) runStart = broken + 1;
+            if (runStart > runEnd) runStart = runEnd = 0;
+        }
+
+        void prune(int today) {
+            for (int i = days.size() - 1; i >= 0; i--) {
+                if (days.keyAt(i) < today - KEEP_DAYS) days.removeAt(i);
+            }
+        }
+
+        int streak(int today) {
+            if (runEnd == 0 || runEnd < today - 1 || runEnd > today || runStart <= broken) return 0;
+            return runEnd - runStart + 1;
+        }
+
+        boolean petValid(int today) {
+            return petName != null && streak(today) >= MIN_SHOWN && petDay >= runStart;
+        }
+
+        /** То, что видно у имени: смена этого числа значит перерисовать. */
+        int shownCode(int today) {
+            final int s = streak(today);
+            if (s < MIN_SHOWN) return 0;
+            return s * 2 + (runEnd < today ? 1 : 0);
+        }
+
+        JSONObject toJson() throws Exception {
+            final JSONObject o = new JSONObject();
+            o.put("s", runStart).put("e", runEnd);
+            if (broken != 0) o.put("b", broken);
+            final JSONArray d = new JSONArray();
+            for (int i = 0; i < days.size(); i++) {
+                d.put(days.keyAt(i)).put(days.valueAt(i));
+            }
+            o.put("d", d);
+            if (petName != null) o.put("n", petName).put("nd", petDay);
+            return o;
+        }
+
+        static Entry fromJson(JSONObject o) {
+            final Entry e = new Entry();
+            e.runStart = o.optInt("s");
+            e.runEnd = o.optInt("e");
+            e.broken = o.optInt("b");
+            final JSONArray d = o.optJSONArray("d");
+            if (d != null) {
+                for (int i = 0; i + 1 < d.length(); i += 2) e.days.put(d.optInt(i), d.optInt(i + 1));
+            }
+            if (o.has("n")) {
+                e.petName = o.optString("n", null);
+                e.petDay = o.optInt("nd");
+            }
+            return e;
+        }
+    }
+
+    private static SharedPreferences store(int account) {
+        return ApplicationLoader.applicationContext.getSharedPreferences("femboy_streaks_" + account, Context.MODE_PRIVATE);
+    }
+
+    /** Только на своей очереди. */
+    private static void save(int account, long did, Entry e) {
+        try {
+            final String json;
+            synchronized (e) {
+                json = e.toJson().toString();
+            }
+            store(account).edit().putString(String.valueOf(did), json).apply();
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+    }
+
+    // ---------------------------------------------------------------- запуск
+
+    /** Поднять учёт для аккаунта. Дёшево, зовётся при каждом чтении. */
+    private static void ensure(int account) {
+        if (account < 0 || account >= started.length) return;
+        if (!started[account]) {
+            started[account] = true;
+            AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account)
+                    .addObserver(INSTANCE, NotificationCenter.didReceiveNewMessages));
+            queue.postRunnable(() -> load(account));
+        }
+        final int today = today();
+        if (backfillChecked[account] != today) {
+            backfillChecked[account] = today;
+            queue.postRunnable(() -> maybeBackfill(account));
+        }
+    }
+
+    private static void load(int account) {
+        try {
+            for (Map.Entry<String, ?> kv : store(account).getAll().entrySet()) {
+                if (kv.getKey().startsWith("_") || !(kv.getValue() instanceof String)) continue;
+                try {
+                    final long did = Long.parseLong(kv.getKey());
+                    final Entry e = Entry.fromJson(new JSONObject((String) kv.getValue()));
+                    entries[account].putIfAbsent(did, e);
+                } catch (Throwable ignored) {
+                }
+            }
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+        notifyUi(account);
+    }
+
+    @Override
+    public void didReceivedNotification(int id, int account, Object... args) {
+        if (id != NotificationCenter.didReceiveNewMessages || args.length < 2) return;
+        if (args.length > 2 && args[2] instanceof Boolean && (Boolean) args[2]) return;
+        if (args.length > 3 && args[3] instanceof Integer && (Integer) args[3] != 0) return;
+        final long did = (Long) args[0];
+        if (!candidate(account, did)) return;
+        @SuppressWarnings("unchecked")
+        final ArrayList<MessageObject> list = (ArrayList<MessageObject>) args[1];
+        if (list == null || list.isEmpty()) return;
+        // только дни и стороны, без самих сообщений
+        final int[] days = new int[list.size()];
+        final int[] flags = new int[list.size()];
+        int n = 0;
+        for (MessageObject m : list) {
+            if (m == null || m.messageOwner == null || m.messageOwner.date == 0) continue;
+            if (m.messageOwner instanceof TLRPC.TL_messageService) continue;
+            days[n] = dayOf(m.messageOwner.date);
+            flags[n] = m.isOut() ? ME : THEM;
+            n++;
+        }
+        if (n == 0) return;
+        final int count = n;
+        queue.postRunnable(() -> {
+            final int today = today();
+            Entry e = entries[account].get(did);
+            if (e == null) {
+                e = new Entry();
+                entries[account].put(did, e);
+            }
+            boolean changed = false;
+            synchronized (e) {
+                for (int i = 0; i < count; i++) changed |= e.mark(days[i], flags[i], today);
+                if (changed) e.prune(today);
+            }
+            if (changed) {
+                save(account, did, e);
+                notifyUi(account);
+            }
+        });
+    }
+
+    // ---------------------------------------------------------------- догрузка из базы
+
+    /** Раз в сутки: собрать дни из своей базы для свежих личных чатов. */
+    private static void maybeBackfill(int account) {
+        final int today = today();
+        if (store(account).getInt(KEY_BACKFILL, 0) == today) return;
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        final int offset = TimeZone.getDefault().getOffset(System.currentTimeMillis()) / 1000;
+        // живая серия бывает только у чата, где писали вчера или сегодня
+        final long yesterdayStart = (long) (today - 1) * 86400L - offset;
+        final long from = (long) (today - BACKFILL_DAYS) * 86400L - offset;
+        storage.getStorageQueue().postRunnable(() -> {
+            final ArrayList<Long> dids = new ArrayList<>();
+            final ArrayList<SparseIntArray> found = new ArrayList<>();
+            SQLiteCursor cursor = null;
+            try {
+                cursor = storage.getDatabase().queryFinalized("SELECT did FROM dialogs WHERE did > 0 AND date >= " + yesterdayStart + " ORDER BY date DESC LIMIT " + (BACKFILL_DIALOGS * 2));
+                while (cursor.next() && dids.size() < BACKFILL_DIALOGS) {
+                    final long did = cursor.longValue(0);
+                    if (candidate(account, did)) dids.add(did);
+                }
+                cursor.dispose();
+                cursor = null;
+                for (long did : dids) {
+                    final SparseIntArray days = new SparseIntArray();
+                    // по суткам сразу в базе: строк не больше числа дней
+                    cursor = storage.getDatabase().queryFinalized("SELECT (date + " + offset + ") / 86400 AS d, MAX(out), MIN(out) FROM messages_v2 WHERE uid = " + did + " AND date >= " + from + " GROUP BY d");
+                    while (cursor.next()) {
+                        int flag = 0;
+                        if (cursor.intValue(1) != 0) flag |= ME;
+                        if (cursor.intValue(2) == 0) flag |= THEM;
+                        days.put(cursor.intValue(0), flag);
+                    }
+                    cursor.dispose();
+                    cursor = null;
+                    found.add(days);
+                }
+            } catch (Throwable t) {
+                FileLog.e(t);
+            } finally {
+                if (cursor != null) cursor.dispose();
+            }
+            queue.postRunnable(() -> {
+                for (int i = 0; i < found.size(); i++) merge(account, dids.get(i), found.get(i), today);
+                store(account).edit().putInt(KEY_BACKFILL, today).apply();
+                notifyUi(account);
+            });
+        });
+    }
+
+    private static void merge(int account, long did, SparseIntArray days, int today) {
+        Entry e = entries[account].get(did);
+        if (e == null) {
+            e = new Entry();
+            entries[account].put(did, e);
+        }
+        synchronized (e) {
+            // отрезок по базе: от последнего засчитанного дня назад
+            int end = 0;
+            for (int i = days.size() - 1; i >= 0; i--) {
+                final int d = days.keyAt(i);
+                if (d <= today && d > e.broken && days.valueAt(i) == BOTH) {
+                    end = d;
+                    break;
+                }
+            }
+            if (end != 0) {
+                int start = end;
+                while (start - 1 > e.broken && days.get(start - 1) == BOTH) start--;
+                if (e.runEnd == 0 || start > e.runEnd + 1) {
+                    e.runStart = start;
+                    e.runEnd = end;
+                } else if (end >= e.runStart - 1) {
+                    // пересекаются или стоят встык: склеить
+                    e.runStart = Math.min(e.runStart, start);
+                    e.runEnd = Math.max(e.runEnd, end);
+                }
+            }
+            for (int i = 0; i < days.size(); i++) {
+                final int d = days.keyAt(i);
+                if (d > e.broken && d <= today && d >= today - KEEP_DAYS) {
+                    e.days.put(d, e.days.get(d) | days.valueAt(i));
+                }
+            }
+            e.chain();
+            e.prune(today);
+        }
+        save(account, did, e);
+    }
+
+    // ---------------------------------------------------------------- кто считается
+
+    /** Личка с живым человеком: не бот, не я, не служебный. */
+    private static boolean candidate(int account, long did) {
+        if (did <= 0 || !DialogObject.isUserDialog(did)) return false;
+        if (did == UserConfig.getInstance(account).getClientUserId()) return false;
+        if (UserObject.isService(did) || did == UserObject.VERIFY || did == UserObject.REPLY_BOT) return false;
+        final TLRPC.User user = MessagesController.getInstance(account).getUser(did);
+        return user == null || !(user.bot || user.self || MessagesController.isSupportUser(user) || UserObject.isDeleted(user));
+    }
+
+    public static boolean eligible(int account, long did) {
+        return candidate(account, did) && MessagesController.getInstance(account).getUser(did) != null;
+    }
+
+    // ---------------------------------------------------------------- чтение
+
+    /** Снимок для экрана питомца. */
+    public static final class State {
+        public int streak;
+        public boolean waiting;
+        public int todayFlags;
+        public String petName;
+    }
+
+    public static State state(int account, long did) {
+        final State s = new State();
+        ensure(account);
+        if (account < 0 || account >= entries.length) return s;
+        final Entry e = entries[account].get(did);
+        if (e == null) return s;
+        final int today = today();
+        synchronized (e) {
+            s.streak = e.streak(today);
+            s.waiting = s.streak > 0 && e.runEnd < today;
+            s.todayFlags = today > e.broken ? e.days.get(today) : 0;
+            s.petName = e.petValid(today) ? e.petName : null;
+        }
+        return s;
+    }
+
+    /**
+     * Местная плашка в переписке: 2 = второй день подряд и сегодня уже
+     * засчитан, 3 = в этот день появилось яйцо. 0 = ничего. Только из памяти.
+     */
+    public static int notice(int account, long did) {
+        if (did <= 0 || account < 0 || account >= entries.length || !flamesEnabled()) return 0;
+        ensure(account);
+        final Entry e = entries[account].get(did);
+        if (e == null) return 0;
+        final int today = today();
+        final int s;
+        synchronized (e) {
+            if (e.runEnd != today) return 0;
+            s = e.streak(today);
+        }
+        return s == 2 || s == MIN_SHOWN ? s : 0;
+    }
+
+    /** Код огонька у имени: 0 — не рисовать, иначе серия * 2 + ждёт. Только из памяти. */
+    private static int shownCode(int account, long did) {
+        if (did <= 0 || account < 0 || account >= entries.length) return 0;
+        ensure(account);
+        if (!flamesEnabled()) return 0;
+        final Entry e = entries[account].get(did);
+        if (e == null) return 0;
+        final int code;
+        synchronized (e) {
+            code = e.shownCode(today());
+        }
+        if (code == 0 || !eligible(account, did)) return 0;
+        return code;
+    }
+
+    /** Ширина огонька с числом у имени, 0 — огонька нет. */
+    public static float nameWidth(Paint paint, int account, long did) {
+        final int code = shownCode(account, did);
+        return code == 0 ? 0 : FemboyStreakDrawable.spanWidth(paint, code / 2);
+    }
+
+    /** Имя с огоньком и серией в конце. Без серии возвращает имя как есть. */
+    public static CharSequence withStreak(View parent, CharSequence name, int account, long did) {
+        if (name == null) return null;
+        final int code = shownCode(account, did);
+        if (code == 0) return name;
+        final android.text.SpannableStringBuilder sb = new android.text.SpannableStringBuilder(name);
+        final int at = sb.length();
+        sb.append("⁠");
+        sb.setSpan(new FemboyStreakDrawable.Span(parent, code / 2, (code & 1) != 0), at, at + 1,
+                android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        return sb;
+    }
+
+    // ---------------------------------------------------------------- питомец
+
+    /** Стадия по серии или -1, если яйца ещё нет. */
+    public static int stage(int streak) {
+        if (streak >= 30) return FemboyPetView.STAGE_ADULT;
+        if (streak >= 10) return FemboyPetView.STAGE_BABY;
+        if (streak >= 7) return FemboyPetView.STAGE_HATCHING;
+        if (streak >= MIN_SHOWN) return FemboyPetView.STAGE_EGG;
+        return -1;
+    }
+
+    /** С какого дня следующая стадия, 0 — дальше расти некуда. */
+    public static int nextStageAt(int streak) {
+        if (streak < MIN_SHOWN) return MIN_SHOWN;
+        if (streak < 7) return 7;
+        if (streak < 10) return 10;
+        if (streak < 30) return 30;
+        return 0;
+    }
+
+    /** С какого дня началась текущая стадия. */
+    public static int stageFrom(int streak) {
+        if (streak >= 30) return 30;
+        if (streak >= 10) return 10;
+        if (streak >= 7) return 7;
+        if (streak >= MIN_SHOWN) return MIN_SHOWN;
+        return 0;
+    }
+
+    public static void setPetName(int account, long did, String name, Runnable done) {
+        queue.postRunnable(() -> {
+            final Entry e = entries[account].get(did);
+            if (e != null) {
+                synchronized (e) {
+                    e.petName = name;
+                    e.petDay = today();
+                }
+                save(account, did, e);
+            }
+            if (done != null) AndroidUtilities.runOnUIThread(done);
+        });
+    }
+
+    /** Оборвать серию руками: счёт с нуля, питомец уходит, новая начнётся завтра. */
+    public static void breakStreak(int account, long did, Runnable done) {
+        queue.postRunnable(() -> {
+            Entry e = entries[account].get(did);
+            if (e == null) {
+                e = new Entry();
+                entries[account].put(did, e);
+            }
+            synchronized (e) {
+                e.broken = today();
+                e.runStart = e.runEnd = 0;
+                e.petName = null;
+                e.petDay = 0;
+                e.days.clear();
+            }
+            save(account, did, e);
+            notifyUi(account);
+            if (done != null) AndroidUtilities.runOnUIThread(done);
+        });
+    }
+
+    // ---------------------------------------------------------------- перерисовка
+
+    private static void notifyUi(int account) {
+        AndroidUtilities.runOnUIThread(() -> {
+            if (notifyPending[account]) return;
+            notifyPending[account] = true;
+            AndroidUtilities.runOnUIThread(() -> {
+                notifyPending[account] = false;
+                NotificationCenter.getInstance(account).postNotificationName(
+                        NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_NAME);
+            }, 300);
+        });
+    }
+
+    private static void notifyAllAccounts() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (UserConfig.getInstance(a).isClientActivated()) notifyUi(a);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyStrings.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyStrings.java
new file mode 100644
index 00000000..74b62636
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyStrings.java
@@ -0,0 +1,72 @@
+package org.telegram.femboy;
+
+/**
+ * Подмена имени в текстах интерфейса.
+ *
+ * Слово «Telegram» встречается не только как название приложения: «Telegram
+ * Premium», «Telegram Stars», «Telegram Business» — это платные услуги
+ * самого телеграма, и переименовывать их во что-то своё было бы враньём:
+ * человек платит телеграму, а не нам. Поэтому такие связки оставляем как
+ * есть, а одиночное имя заменяем.
+ *
+ * Ссылки не трогаем: в них имя пишется строчными (telegram.org), а мы ищем
+ * слово с большой буквы.
+ */
+public class FemboyStrings {
+
+    private static final String NAME = "Telegram";
+
+    /** Что после имени означает «это их услуга, не переименовывать». */
+    private static final String[] KEEP_AFTER = {
+            " Premium", " Stars", " Business", " Wallet", " Passport", " Ads", " API", " FAQ"
+    };
+
+    /**
+     * Наши собственные строки не переименовываем.
+     *
+     * Они уже написаны так, как надо, и слово «Telegram» в них стоит там, где
+     * речь именно о телеграме. Английское «Femboy (formerly Femboy) is a
+     * Telegram fork» подмена превращала в «is a Femboy fork» — то есть форк
+     * самого себя. Русский текст уцелел случайно: там «форк телеграма» с
+     * маленькой буквы и кириллицей.
+     *
+     * Признак свой/чужой — ключ ресурса: все наши начинаются с Femboy.
+     */
+    public static String rename(String key, String value) {
+        if (key != null && (key.startsWith("Femboy") || key.startsWith("Femboy"))) {
+            return value;
+        }
+        return rename(value);
+    }
+
+    public static String rename(String value) {
+        if (value == null || value.indexOf(NAME) < 0) {
+            return value;
+        }
+        StringBuilder out = new StringBuilder(value.length());
+        int from = 0;
+        while (true) {
+            int at = value.indexOf(NAME, from);
+            if (at < 0) {
+                out.append(value, from, value.length());
+                break;
+            }
+            int end = at + NAME.length();
+            // Часть более длинного слова (Telegrammer и подобное) не трогаем.
+            boolean wordEnd = end >= value.length() || !Character.isLetterOrDigit(value.charAt(end));
+            boolean wordStart = at == 0 || !Character.isLetterOrDigit(value.charAt(at - 1));
+            boolean keep = !wordStart || !wordEnd;
+            if (!keep) {
+                for (String tail : KEEP_AFTER) {
+                    if (value.startsWith(tail, end)) {
+                        keep = true;
+                        break;
+                    }
+                }
+            }
+            out.append(value, from, at).append(keep ? NAME : FemboyConfig.APP_NAME);
+            from = end;
+        }
+        return out.toString();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboySubclass.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboySubclass.java
new file mode 100644
index 00000000..0d888c15
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboySubclass.java
@@ -0,0 +1,206 @@
+package org.telegram.femboy;
+
+import com.android.dx.stock.ProxyBuilder;
+
+import org.telegram.messenger.ApplicationLoader;
+
+import java.io.File;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Наследник java-класса, написанный на питоне: то, что у экстеры зовётся
+ * java_subclass. Мост питона сам наследует только интерфейсы, поэтому
+ * класс-наследник собирается на ходу dexmaker'ом, как у них. Все методы
+ * проходят через обработчик, но в питон уходят только те, что плагин
+ * переопределил; остальные сразу идут к родителю.
+ */
+public final class FemboySubclass {
+
+    private FemboySubclass() {}
+
+    /** Питоновская сторона: переопределённый метод. */
+    public interface Target {
+        Object invoke(Object self, Method method, Object[] args) throws Throwable;
+    }
+
+    private static final class Handler implements InvocationHandler {
+        final Set<String> names;
+        final Target target;
+
+        Handler(Set<String> names, Target target) {
+            this.names = names;
+            this.target = target;
+        }
+
+        @Override
+        public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
+            if (names.contains(method.getName())) {
+                return target.invoke(proxy, method, args == null ? new Object[0] : args);
+            }
+            if (Modifier.isAbstract(method.getModifiers())) {
+                return defaultValue(method.getReturnType());
+            }
+            return ProxyBuilder.callSuper(proxy, method, args);
+        }
+    }
+
+    private static File cache() {
+        File dir = new File(ApplicationLoader.applicationContext.getCodeCacheDir(), "femboy_classes");
+        dir.mkdirs();
+        return dir;
+    }
+
+    public static Object create(Class<?> base, Object[] args, String[] overridden, Target target) throws Throwable {
+        if (args == null) args = new Object[0];
+        Set<String> names = new HashSet<>(Arrays.asList(overridden == null ? new String[0] : overridden));
+        Handler handler = new Handler(names, target);
+        ProxyBuilder<?> builder;
+        if (base.isInterface()) {
+            builder = ProxyBuilder.forClass(Object.class).implementing(base);
+        } else {
+            builder = ProxyBuilder.forClass(base);
+            Constructor<?> constructor = pick(base, args);
+            if (constructor == null) {
+                throw new IllegalArgumentException("у " + base.getName() + " нет конструктора на " + args.length + " доводов подходящих типов");
+            }
+            Class<?>[] types = constructor.getParameterTypes();
+            Object[] values = new Object[args.length];
+            for (int i = 0; i < args.length; i++) values[i] = coerce(args[i], types[i]);
+            builder.constructorArgTypes(types).constructorArgValues(values);
+        }
+        builder.parentClassLoader(FemboySubclass.class.getClassLoader()).dexCache(cache()).handler(handler);
+        return builder.build();
+    }
+
+    public static Object callSuper(Object proxy, Method method, Object[] args) throws Throwable {
+        Class<?>[] types = method.getParameterTypes();
+        Object[] values = new Object[types.length];
+        for (int i = 0; i < types.length && args != null && i < args.length; i++) values[i] = coerce(args[i], types[i]);
+        if (Modifier.isFinal(method.getModifiers()) || method.getDeclaringClass().isInterface()) {
+            // у final-методов нет копии родителя: они и так не переопределены
+            method.setAccessible(true);
+            return method.invoke(proxy, values);
+        }
+        return ProxyBuilder.callSuper(proxy, method, values);
+    }
+
+    /** Методы с этим именем у класса и его родителей, открытые и защищённые. */
+    public static Method[] methods(Class<?> base, String name) {
+        java.util.ArrayList<Method> out = new java.util.ArrayList<>();
+        HashSet<String> seen = new HashSet<>();
+        for (Class<?> k = base; k != null; k = k.getSuperclass()) {
+            for (Method m : k.getDeclaredMethods()) {
+                if (!m.getName().equals(name)) continue;
+                int mod = m.getModifiers();
+                if (Modifier.isPrivate(mod) || Modifier.isStatic(mod)) continue;
+                String key = Arrays.toString(m.getParameterTypes());
+                if (seen.add(key)) {
+                    m.setAccessible(true);
+                    out.add(m);
+                }
+            }
+        }
+        for (Class<?> i : base.getInterfaces()) {
+            for (Method m : i.getMethods()) {
+                if (m.getName().equals(name) && seen.add(Arrays.toString(m.getParameterTypes()))) out.add(m);
+            }
+        }
+        return out.toArray(new Method[0]);
+    }
+
+    /** Имена всех методов, которые можно переопределить: из них собирается super() в питоне. */
+    public static String[] names(Class<?> base) {
+        HashSet<String> out = new HashSet<>();
+        for (Class<?> k = base; k != null; k = k.getSuperclass()) {
+            for (Method m : k.getDeclaredMethods()) {
+                int mod = m.getModifiers();
+                if (!Modifier.isPrivate(mod) && !Modifier.isStatic(mod) && !Modifier.isFinal(mod)) out.add(m.getName());
+            }
+        }
+        for (Method m : base.getMethods()) {
+            if (!Modifier.isFinal(m.getModifiers()) && !Modifier.isStatic(m.getModifiers())) out.add(m.getName());
+        }
+        return out.toArray(new String[0]);
+    }
+
+    /** Подходит ли набор доводов под типы: для выбора перегрузки из питона. */
+    public static boolean fits(Class<?>[] types, Object[] args) {
+        if (args == null) args = new Object[0];
+        if (types.length != args.length) return false;
+        for (int i = 0; i < types.length; i++) {
+            if (!fits(types[i], args[i])) return false;
+        }
+        return true;
+    }
+
+    private static Constructor<?> pick(Class<?> base, Object[] args) {
+        for (Constructor<?> c : base.getDeclaredConstructors()) {
+            if (Modifier.isPrivate(c.getModifiers())) continue;
+            if (fits(c.getParameterTypes(), args)) return c;
+        }
+        return null;
+    }
+
+    private static boolean fits(Class<?> type, Object value) {
+        if (value == null) return !type.isPrimitive();
+        Class<?> boxed = box(type);
+        if (boxed.isInstance(value)) return true;
+        if (value instanceof Number && Number.class.isAssignableFrom(boxed)) return true;
+        if (value instanceof Number && boxed == Character.class) return true;
+        if (value instanceof String && (boxed == Character.class || type == CharSequence.class)) return true;
+        return false;
+    }
+
+    private static Object coerce(Object value, Class<?> type) {
+        if (value == null) return null;
+        Class<?> boxed = box(type);
+        if (boxed.isInstance(value)) return value;
+        if (value instanceof Number) {
+            Number n = (Number) value;
+            if (boxed == Integer.class) return n.intValue();
+            if (boxed == Long.class) return n.longValue();
+            if (boxed == Float.class) return n.floatValue();
+            if (boxed == Double.class) return n.doubleValue();
+            if (boxed == Short.class) return n.shortValue();
+            if (boxed == Byte.class) return n.byteValue();
+            if (boxed == Character.class) return (char) n.intValue();
+        }
+        if (value instanceof String && boxed == Character.class && ((String) value).length() > 0) {
+            return ((String) value).charAt(0);
+        }
+        return value;
+    }
+
+    /** Ответ питона под тип, который ждёт java: int из питона приходит как Long. */
+    public static Object result(Object value, Class<?> type) {
+        if (type == void.class || type == Void.class) return null;
+        if (value == null) return defaultValue(type);
+        return coerce(value, type);
+    }
+
+    private static Object defaultValue(Class<?> type) {
+        if (!type.isPrimitive() || type == void.class) return null;
+        if (type == boolean.class) return false;
+        if (type == char.class) return (char) 0;
+        return coerce(0, type);
+    }
+
+    private static Class<?> box(Class<?> type) {
+        if (!type.isPrimitive()) return type;
+        if (type == int.class) return Integer.class;
+        if (type == long.class) return Long.class;
+        if (type == boolean.class) return Boolean.class;
+        if (type == float.class) return Float.class;
+        if (type == double.class) return Double.class;
+        if (type == short.class) return Short.class;
+        if (type == byte.class) return Byte.class;
+        if (type == char.class) return Character.class;
+        return Void.class;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTags.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTags.java
new file mode 100644
index 00000000..beea0590
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTags.java
@@ -0,0 +1,152 @@
+package org.telegram.femboy;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Свой писатель тегов ID3v2.3 — название, исполнитель, обложка.
+ *
+ * Почему теги пишутся в файл, а не подставляются при отправке: телеграм,
+ * отправляя mp3, сам читает из него теги и складывает их в атрибуты документа,
+ * а обложку — в превью. Значит достаточно поправить файл, и всё остальное
+ * произойдёт само, тем же кодом, что и обычно. Собирать документ руками
+ * означало бы дублировать чужую работу и разойтись с ней на следующей версии.
+ *
+ * Библиотеки для этого не беру: формат простой, а лишняя зависимость в чужом
+ * дереве — это то, что придётся тащить через все будущие обновления.
+ */
+public class FemboyTags {
+
+    /** Заголовок ID3v2 занимает десять байт, дальше идут кадры. */
+    private static final int HEADER = 10;
+
+    /**
+     * Размер в заголовке пишется «безопасными» семибитными байтами: старший бит
+     * каждого байта всегда ноль, чтобы кусок тега не притворился началом
+     * звукового кадра.
+     */
+    private static void writeSynchsafe(OutputStream out, int value) throws Exception {
+        out.write((value >> 21) & 0x7F);
+        out.write((value >> 14) & 0x7F);
+        out.write((value >> 7) & 0x7F);
+        out.write(value & 0x7F);
+    }
+
+    private static void writeInt(OutputStream out, int value) throws Exception {
+        out.write((value >> 24) & 0xFF);
+        out.write((value >> 16) & 0xFF);
+        out.write((value >> 8) & 0xFF);
+        out.write(value & 0xFF);
+    }
+
+    private static void frame(ByteArrayOutputStream out, String id, byte[] body) throws Exception {
+        out.write(id.getBytes(StandardCharsets.ISO_8859_1));
+        writeInt(out, body.length);
+        out.write(0);
+        out.write(0);
+        out.write(body);
+    }
+
+    /** Текстовый кадр: признак кодировки, затем UTF-16 с меткой порядка байт. */
+    private static byte[] text(String value) throws Exception {
+        final ByteArrayOutputStream body = new ByteArrayOutputStream();
+        body.write(1);
+        body.write(0xFF);
+        body.write(0xFE);
+        body.write(value.getBytes(StandardCharsets.UTF_16LE));
+        return body.toByteArray();
+    }
+
+    /** Кадр с картинкой: кодировка, mime, тип (3 — передняя обложка), подпись. */
+    private static byte[] picture(byte[] jpeg) throws Exception {
+        final ByteArrayOutputStream body = new ByteArrayOutputStream();
+        body.write(0);
+        body.write("image/jpeg".getBytes(StandardCharsets.ISO_8859_1));
+        body.write(0);
+        body.write(3);
+        body.write(0);
+        body.write(jpeg);
+        return body.toByteArray();
+    }
+
+    /** Сколько байт в начале файла занимает старый тег, если он там есть. */
+    private static int oldTagLength(InputStream in) throws Exception {
+        final byte[] head = new byte[HEADER];
+        if (in.read(head) != HEADER) {
+            return 0;
+        }
+        if (head[0] != 'I' || head[1] != 'D' || head[2] != '3') {
+            return -1;   // тега нет, эти десять байт — уже музыка
+        }
+        int size = 0;
+        for (int i = 6; i < 10; i++) {
+            size = (size << 7) | (head[i] & 0x7F);
+        }
+        return size;
+    }
+
+    /**
+     * Переписывает src в dst с новыми тегами. Пустые значения пропускаются:
+     * пустой кадр и отсутствие кадра — разные вещи, и второе честнее.
+     */
+    public static boolean write(File src, File dst, String title, String artist, byte[] cover) {
+        try (InputStream in = new FileInputStream(src);
+             OutputStream out = new FileOutputStream(dst)) {
+
+            final ByteArrayOutputStream frames = new ByteArrayOutputStream();
+            if (title != null && !title.isEmpty()) {
+                frame(frames, "TIT2", text(title));
+            }
+            if (artist != null && !artist.isEmpty()) {
+                frame(frames, "TPE1", text(artist));
+            }
+            if (cover != null && cover.length > 0) {
+                frame(frames, "APIC", picture(cover));
+            }
+            final byte[] body = frames.toByteArray();
+
+            out.write("ID3".getBytes(StandardCharsets.ISO_8859_1));
+            out.write(3);
+            out.write(0);
+            out.write(0);
+            writeSynchsafe(out, body.length);
+            out.write(body);
+
+            final int skip = oldTagLength(in);
+            if (skip < 0) {
+                // Старого тега не было — те десять байт, что мы уже прочитали,
+                // надо вернуть на место, иначе музыка начнётся с середины.
+                try (InputStream again = new FileInputStream(src)) {
+                    copy(again, out);
+                }
+            } else {
+                long left = skip;
+                final byte[] buf = new byte[8192];
+                while (left > 0) {
+                    final int read = in.read(buf, 0, (int) Math.min(buf.length, left));
+                    if (read <= 0) {
+                        break;
+                    }
+                    left -= read;
+                }
+                copy(in, out);
+            }
+            return true;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private static void copy(InputStream in, OutputStream out) throws Exception {
+        final byte[] buf = new byte[16384];
+        int read;
+        while ((read = in.read(buf)) > 0) {
+            out.write(buf, 0, read);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTheme.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTheme.java
new file mode 100644
index 00000000..3958c775
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyTheme.java
@@ -0,0 +1,79 @@
+package org.telegram.femboy;
+
+import org.telegram.messenger.FileLog;
+import org.telegram.ui.ActionBar.Theme;
+
+/**
+ * Тема по умолчанию — нежно-розовая, с лавандовым и голубым рядом.
+ *
+ * Свою тему не рисуем: акценты уже есть в ночной теме телеграма. У «Night»
+ * акцент с id 11 — розовый (0xFFDE5E7E), 10 — лавандовый (0xFF8D78E3),
+ * 12 — голубой (0xFF5977E8). Первый запуск ставит розовый; поверх него
+ * работает Material You с пастельным розовым сидом, так что вся палитра
+ * получается нежной, а не кислотной.
+ *
+ * Ставится ровно один раз, при первом запуске. Если человек потом выберет
+ * другую тему, форк в этот выбор больше не лезет.
+ */
+public class FemboyTheme {
+
+    public static final int PINK_ACCENT_ID = 11;
+    public static final int LAVENDER_ACCENT_ID = 10;
+    public static final int BLUE_ACCENT_ID = 12;
+
+    public static void applyOnFirstLaunch() {
+        try {
+            if (!FemboyConfig.claimFirstLaunch()) {
+                return;
+            }
+            Theme.ThemeInfo night = Theme.getTheme("Night");
+            if (night == null) {
+                return;
+            }
+            night.setCurrentAccentId(PINK_ACCENT_ID);
+            Theme.saveThemeAccents(night, true, false, true, false);
+            Theme.applyTheme(night);
+        } catch (Exception e) {
+            // Тема — не то, ради чего стоит ронять запуск.
+            FileLog.e(e);
+        }
+    }
+
+    /**
+     * Material You светлый днём и тёмный ночью, как телефон: дневная тема
+     * светлая, ночная тёмная, переключение по системе. Делается один раз при
+     * первом запуске с Material You (или когда его включают руками), дальше
+     * выбор человека не трогаем.
+     */
+    public static void followSystemDayNight(boolean force) {
+        try {
+            if (!FemboyYou.enabled()) {
+                return;
+            }
+            android.content.SharedPreferences prefs = FemboyConfig.prefs();
+            if (!force && prefs.getBoolean("md3_day_night", false)) {
+                return;
+            }
+            prefs.edit().putBoolean("md3_day_night", true).apply();
+            Theme.ThemeInfo night = Theme.getCurrentNightTheme();
+            if (night == null || !night.isDark()) {
+                night = Theme.getTheme("Night");
+            }
+            if (night != null) {
+                Theme.setCurrentNightTheme(night);
+            }
+            Theme.ThemeInfo day = Theme.getCurrentTheme();
+            if (day == null || day.isDark()) {
+                Theme.ThemeInfo blue = Theme.getTheme("Blue");
+                if (blue != null) {
+                    Theme.applyTheme(blue, false);
+                }
+            }
+            Theme.selectedAutoNightType = Theme.AUTO_NIGHT_TYPE_SYSTEM;
+            Theme.saveAutoNightThemeConfig();
+            Theme.checkAutoNightThemeConditions(true);
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyUpdate.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyUpdate.java
new file mode 100644
index 00000000..360691d5
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyUpdate.java
@@ -0,0 +1,402 @@
+package org.telegram.femboy;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+
+import androidx.core.content.FileProvider;
+
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+
+/**
+ * Обновление форка мимо магазина.
+ *
+ * В репозитории лежит файл с номером последней версии и ссылкой на apk. Клиент
+ * знает свой номер, сравнивает и, если в файле новее, показывает внизу экрана
+ * ту же полоску, что телеграм показывает для своих бета-сборок.
+ *
+ * Почему не штатный механизм телеграма: он качает не по ссылке, а документ из
+ * переписки, через свою файловую очередь. Наш apk лежит на гитхабе и документом
+ * не является, поэтому скачивание здесь своё.
+ */
+public class FemboyUpdate {
+
+    /** Файл с описанием последней версии и ключ, под которым он лежит в кэше. */
+    private static final String FILE = "version.json";
+    private static final String CACHE_KEY = "version";
+
+    private static final String PREFS = "femboy_update";
+    /** Версия, под которую скачан apk. Пусто — скачанного нет. */
+    private static final String KEY_READY_VERSION = "ready_version";
+
+    private static volatile boolean downloading;
+    private static volatile float progress;
+    /** Скачивание можно отменить: полоска умеет и это. */
+    private static volatile boolean cancelled;
+
+    /** Что написано в файле про последнюю версию. */
+    public static final class Info {
+        public final String version;
+        public final String apk;
+        private final JSONObject json;
+
+        Info(String version, String apk, JSONObject json) {
+            this.version = version;
+            this.apk = apk;
+            this.json = json;
+        }
+
+        /** Что нового — строкой на языке приложения. Может быть пустым. */
+        public String about() {
+            return FemboyRemote.localized(json, "about", "");
+        }
+
+        /**
+         * Как выпуск называется для человека: «Пререлиз 1.0», «Бета 1.1».
+         *
+         * Отдельно от version, потому что version сравнивается числами. Нет
+         * метки — показываем само число, так было всегда и хуже не станет.
+         */
+        public String label() {
+            final String value = FemboyRemote.localized(json, "label", "");
+            return value == null || value.isEmpty() ? version : value;
+        }
+    }
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * Спрашивает гитхаб про последнюю версию. Зовётся кнопкой и расписанием.
+     *
+     * Ответ всегда кладётся в кэш, поэтому даже неудачная проверка не делает
+     * хуже: показывается то, что знали раньше.
+     */
+    /**
+     * Проверка и версии, и значков разом. Для человека это одно действие:
+     * «посмотри, не появилось ли нового».
+     */
+    public static void checkAll(Runnable done) {
+        check(done);
+    }
+
+    public static void check(Runnable done) {
+        lastCheck = System.currentTimeMillis();
+        FemboyRemote.fetch(FILE, CACHE_KEY, text -> {
+            if (done != null) {
+                done.run();
+            }
+        });
+    }
+
+    /** Когда в последний раз спрашивали, за этот запуск приложения. */
+    private static long lastCheck;
+    /** Расписание живёт в одном экземпляре: второй пересоздаст очередь. */
+    private static Runnable scheduled;
+
+    public static long lastCheckTime() {
+        return lastCheck;
+    }
+
+    /**
+     * Ставит проверку по расписанию: раз в столько минут, сколько выбрано в
+     * настройках. Ноль — не проверять вовсе.
+     *
+     * Зовётся при запуске и после смены значения в настройках, поэтому первым
+     * делом снимает прошлое расписание: иначе после трёх заходов в настройки
+     * проверок стало бы три.
+     */
+    public static void schedule() {
+        if (scheduled != null) {
+            AndroidUtilities.cancelRunOnUIThread(scheduled);
+            scheduled = null;
+        }
+        final int minutes = FemboyConfig.updateIntervalMinutes();
+        if (minutes <= 0) {
+            return;
+        }
+        final long delay = minutes * 60L * 1000L;
+        scheduled = new Runnable() {
+            @Override
+            public void run() {
+                // Настройку могли выключить, пока мы ждали своей очереди.
+                if (FemboyConfig.updateIntervalMinutes() <= 0) {
+                    scheduled = null;
+                    return;
+                }
+                check(() -> org.telegram.messenger.NotificationCenter.getGlobalInstance()
+                        .postNotificationName(org.telegram.messenger.NotificationCenter.appUpdateAvailable));
+                // Заодно перечитываем значки. Раньше они читались только при
+                // запуске приложения, и у того, кто держит телеграм открытым
+                // сутками, новый значок не появлялся вовсе — ровно та же
+                // беда, из-за которой здесь и завелось расписание.
+                        AndroidUtilities.runOnUIThread(this, delay);
+            }
+        };
+        AndroidUtilities.runOnUIThread(scheduled, delay);
+    }
+
+    /**
+     * Версия из файла, если она новее нашей. Иначе null.
+     *
+     * Ничего не качает: работает по тому, что уже скачано и лежит в кэше.
+     */
+    public static Info available() {
+        final String text = FemboyRemote.cached(CACHE_KEY);
+        if (text == null) {
+            return null;
+        }
+        try {
+            final JSONObject json = new JSONObject(text);
+            final String version = json.optString("version", null);
+            final String apk = json.optString("apk", null);
+            if (version == null || apk == null || version.isEmpty() || apk.isEmpty()) {
+                return null;
+            }
+            return newer(version, FemboyConfig.APP_VERSION) ? new Info(version, apk, json) : null;
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    /**
+     * Больше ли первый номер второго. Сравниваем по числам через точку, а не
+     * строкой: иначе «0.10» оказалось бы меньше «0.9».
+     */
+    static boolean newer(String candidate, String current) {
+        final String[] a = candidate.split("\\.");
+        final String[] b = current.split("\\.");
+        for (int i = 0; i < Math.max(a.length, b.length); i++) {
+            final int left = number(a, i);
+            final int right = number(b, i);
+            if (left != right) {
+                return left > right;
+            }
+        }
+        return false;
+    }
+
+    private static int number(String[] parts, int index) {
+        if (index >= parts.length) {
+            return 0;
+        }
+        try {
+            return Integer.parseInt(parts[index].trim());
+        } catch (Exception ignored) {
+            return 0;
+        }
+    }
+
+    /**
+     * Адрес, по которому точно приедет свежий файл.
+     *
+     * Имя файла в ветке постоянное, а гитхаб отдаёт его через кэш на пять
+     * минут. Сразу после выпуска это значит, что можно получить байты прошлой
+     * сборки — и получить их молча, с кодом 200. Владелец на это и наступил:
+     * обновлялка ставила прошлую версию, приложение оставалось старым, полоска
+     * появлялась снова, и так по кругу.
+     *
+     * Номер версии в запросе делает адрес другим для каждого выпуска, а другой
+     * адрес кэш ещё не видел.
+     */
+    private static String fresh(Info info) {
+        if (info.apk == null || info.apk.isEmpty()) {
+            return "";
+        }
+        return info.apk + (info.apk.indexOf('?') >= 0 ? "&" : "?") + "v="
+                + android.net.Uri.encode(info.version);
+    }
+
+    /**
+     * Правда ли в этом файле версия новее той, что работает.
+     *
+     * Раньше готовность помечалась тем номером, который мы ОЖИДАЛИ скачать.
+     * Ожидание — не проверка: если приехали чужие байты, отметка всё равно
+     * говорила «готово», и дальше этот файл ставился уже без всякой закачки,
+     * навсегда. Спрашиваем систему, что лежит в файле на самом деле.
+     *
+     * Не «равна ли объявленной», а «новее ли установленной»: номер сборки в
+     * apk и номер выпуска в version.json — разные числа, и сводить их
+     * значило бы завести ещё одно место, где они могут разойтись.
+     */
+    private static boolean newerThanInstalled(File file) {
+        try {
+            final android.content.Context context = ApplicationLoader.applicationContext;
+            final android.content.pm.PackageManager manager = context.getPackageManager();
+            final android.content.pm.PackageInfo downloaded =
+                    manager.getPackageArchiveInfo(file.getAbsolutePath(), 0);
+            if (downloaded == null) {
+                return false;       // не apk вовсе
+            }
+            final android.content.pm.PackageInfo mine =
+                    manager.getPackageInfo(context.getPackageName(), 0);
+            return downloaded.versionCode > mine.versionCode;
+        } catch (Throwable t) {
+            FileLog.e(t);
+            // Не смогли посмотреть — не запрещаем: обновление важнее, чем моя
+            // уверенность, а хуже проверки только проверка, ломающая работу.
+            return true;
+        }
+    }
+
+    /** Куда кладём скачанное. Папка уже описана в provider_paths. */
+    private static File file() {
+        final File directory = new File(ApplicationLoader.getFilesDirFixed(), "cache");
+        if (!directory.exists()) {
+            directory.mkdirs();
+        }
+        return new File(directory, "femboy_update.apk");
+    }
+
+    /** Скачанный apk именно этой версии или null. */
+    public static File downloaded() {
+        final Info info = available();
+        if (info == null) {
+            return null;
+        }
+        if (!info.version.equals(prefs().getString(KEY_READY_VERSION, null))) {
+            return null;
+        }
+        final File file = file();
+        return file.exists() && file.length() > 0 ? file : null;
+    }
+
+    public static boolean downloading() {
+        return downloading;
+    }
+
+    public static float progress() {
+        return progress;
+    }
+
+    public static void cancel() {
+        cancelled = true;
+    }
+
+    /**
+     * Качает apk. onChange зовётся в главном потоке на каждом шаге — полоска
+     * по нему и перерисовывается.
+     */
+    public static void download(Runnable onChange) {
+        final Info info = available();
+        if (info == null || downloading) {
+            return;
+        }
+        downloading = true;
+        cancelled = false;
+        progress = 0f;
+        final Thread worker = new Thread(() -> {
+            boolean ok = false;
+            HttpURLConnection connection = null;
+            final File target = file();
+            try {
+                connection = (HttpURLConnection) new URL(fresh(info)).openConnection();
+                connection.setConnectTimeout(20000);
+                connection.setReadTimeout(20000);
+                connection.setInstanceFollowRedirects(true);
+                connection.setRequestProperty("User-Agent", FemboyConfig.APP_NAME);
+                connection.setRequestProperty("Cache-Control", "no-cache");
+                connection.setUseCaches(false);
+                if (connection.getResponseCode() == 200) {
+                    final long total = connection.getContentLength();
+                    try (InputStream in = connection.getInputStream();
+                         OutputStream out = new FileOutputStream(target)) {
+                        final byte[] buffer = new byte[16384];
+                        long written = 0;
+                        int read;
+                        while ((read = in.read(buffer)) > 0) {
+                            if (cancelled) {
+                                break;
+                            }
+                            out.write(buffer, 0, read);
+                            written += read;
+                            if (total > 0) {
+                                progress = written / (float) total;
+                                if (onChange != null) {
+                                    AndroidUtilities.runOnUIThread(onChange);
+                                }
+                            }
+                        }
+                        ok = !cancelled && (total <= 0 || written >= total);
+                    }
+                }
+            } catch (Throwable t) {
+                FileLog.e(t);
+            } finally {
+                if (connection != null) {
+                    connection.disconnect();
+                }
+            }
+            // Целиком скачанный — ещё не значит нужный. Проверяем, что в файле
+            // лежит версия новее установленной, и только тогда считаем готовым.
+            if (ok && !newerThanInstalled(target)) {
+                ok = false;
+                FemboyPluginHost.log("femboy",
+                        "скачался apk не новее установленного — не ставим", true);
+            }
+            // Недокачанный файл не должен притворяться готовым: помечаем
+            // готовность только целиком скачанной версией.
+            if (ok) {
+                prefs().edit().putString(KEY_READY_VERSION, info.version).apply();
+            } else {
+                prefs().edit().remove(KEY_READY_VERSION).apply();
+                target.delete();
+            }
+            downloading = false;
+            progress = 0f;
+            if (onChange != null) {
+                AndroidUtilities.runOnUIThread(onChange);
+            }
+        }, "femboy-update");
+        worker.setDaemon(true);
+        worker.start();
+    }
+
+    /**
+     * Отдаёт скачанный apk системе. Ставить будет она, спросив человека, —
+     * молча подменить себе приложение нельзя, и это правильно.
+     */
+    public static void install(Activity activity) {
+        final File file = downloaded();
+        if (activity == null || file == null) {
+            return;
+        }
+        // Последняя проверка перед тем, как отдать файл системе. Отметка
+        // «готово» — наша память, а память бывает неверной; сам файл соврать
+        // не может. Стоит здесь, а не в downloaded(): туда заглядывают на
+        // каждой перерисовке списка, а разбор apk на это не рассчитан.
+        if (!newerThanInstalled(file)) {
+            prefs().edit().remove(KEY_READY_VERSION).apply();
+            file.delete();
+            return;
+        }
+        try {
+            final Intent intent = new Intent(Intent.ACTION_VIEW);
+            intent.setFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            if (Build.VERSION.SDK_INT >= 24) {
+                intent.setDataAndType(FileProvider.getUriForFile(activity,
+                        ApplicationLoader.getApplicationId() + ".provider", file),
+                        "application/vnd.android.package-archive");
+            } else {
+                intent.setDataAndType(Uri.fromFile(file), "application/vnd.android.package-archive");
+            }
+            activity.startActivityForResult(intent, 500);
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyWordmark.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyWordmark.java
new file mode 100644
index 00000000..419c730b
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyWordmark.java
@@ -0,0 +1,84 @@
+package org.telegram.femboy;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+import android.text.TextPaint;
+
+import androidx.annotation.NonNull;
+
+import org.telegram.messenger.AndroidUtilities;
+
+/**
+ * Название форка, нарисованное текстом вместо картинки.
+ *
+ * На главном экране телеграм показывает имя двумя способами: развёрнутый
+ * заголовок — настоящей надписью, а свёрнутый — картинкой со словом
+ * «Telegram». Владелец это и заметил: имя менялось только когда развёрнуты
+ * истории. Картинку рисовать смысла нет, поэтому здесь просто текст,
+ * притворяющийся картинкой.
+ *
+ * Красится он белым, потому что поверх стоит цветовой фильтр умножением:
+ * белое умножается на цвет темы и становится этим цветом.
+ */
+public class FemboyWordmark extends Drawable {
+
+    private final TextPaint paint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final int height;
+
+    public FemboyWordmark() {
+        this(20);
+    }
+
+    /** Высота букв. На главном экране одна, на экране до входа крупнее. */
+    public FemboyWordmark(int heightDp) {
+        height = AndroidUtilities.dp(heightDp);
+        paint.setTypeface(AndroidUtilities.bold());
+        paint.setColor(0xFFFFFFFF);
+        paint.setTextSize(height);
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        final Rect b = getBounds();
+        paint.setTextSize(height);
+        float w = paint.measureText(FemboyConfig.APP_NAME);
+        if (w > b.width() && w > 0) {
+            paint.setTextSize(height * b.width() / w);
+            w = paint.measureText(FemboyConfig.APP_NAME);
+        }
+        final Paint.FontMetrics fm = paint.getFontMetrics();
+        canvas.drawText(FemboyConfig.APP_NAME, b.left,
+                b.centerY() - (fm.ascent + fm.descent) / 2f, paint);
+    }
+
+    @Override
+    public int getIntrinsicWidth() {
+        return (int) Math.ceil(paint.measureText(FemboyConfig.APP_NAME));
+    }
+
+    @Override
+    public int getIntrinsicHeight() {
+        return height;
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        paint.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+        paint.setColorFilter(colorFilter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/femboy/FemboyYou.java b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyYou.java
new file mode 100644
index 00000000..9f379d41
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/femboy/FemboyYou.java
@@ -0,0 +1,699 @@
+package org.telegram.femboy;
+
+import android.content.Context;
+import android.os.Build;
+import android.util.SparseIntArray;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.ActionBar.ThemeColors;
+
+/**
+ * Material You: цвета темы телеграма из палитры телефона.
+ *
+ * Тема телеграма остаётся какой была (светлая днём, тёмная ночью), а поверх
+ * неё каждый ключ перекрашивается. Главные ключи (фоны, текст, кнопки,
+ * пузыри) получают роли MD3 напрямую. Остальные сотни ключей проходят через
+ * общее правило: серое становится нейтральным тоном палитры той же светлоты,
+ * синее и акцентное становится основным тоном, а красное, зелёное и прочие
+ * смысловые цвета остаются своими.
+ *
+ * На андроиде 12 и новее палитра берётся у системы (Monet, цвета обоев),
+ * на старых строится из мятного цвета Femboy.
+ *
