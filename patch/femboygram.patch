+package com.exteragram.messenger;
+
+/**
+ * Настройки exteraGram под их именами. Плагины читают отсюда поля вроде
+ * pluginsSafeMode; у Femboy этих настроек нет, поэтому здесь их значения по
+ * умолчанию, как в самом exteraGram. Сгенерировано из их ExteraConfig.kt.
+ */
+public final class ExteraConfig {
+    private ExteraConfig() {}
+    public static int translationProvider = 0;
+    public static boolean disableNumberRounding = false;
+    public static boolean formatTimeWithSeconds = false;
+    public static boolean relativeLastSeen = false;
+    public static boolean inAppVibration = true;
+    public static boolean disableNotificationDelay = false;
+    public static boolean filterZalgo = true;
+    public static int downloadSpeedBoost = 0;
+    public static boolean uploadSpeedBoost = false;
+    public static boolean hidePhoneNumber = false;
+    public static int showIdAndDc = 1;
+    public static boolean hideArchiveFolder = false;
+    public static boolean archiveOnPull = false;
+    public static boolean disableUnarchiveSwipe = true;
+    public static int doNotUseProxy = 0;
+    public static String customSavePath = "exteraGram";
+    public static String editingIconPackId = null;
+    public static float avatarCorners = 28f;
+    public static boolean singleCornerRadius = false;
+    public static boolean forceSnow = false;
+    public static boolean hideActionBarStatus = false;
+    public static boolean centerTitle = false;
+    public static boolean hideStories = false;
+    public static boolean hideFloatingButton = false;
+    public static boolean hideDialogsSearchBar = false;
+    public static boolean senderMiniAvatars = true;
+    public static int titleText = 0;
+    public static boolean hideAllChats = false;
+    public static boolean squareFab = true;
+    public static float sectionRadius = 20f;
