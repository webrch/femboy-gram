+ */
+public final class FemboyMusic {
+
+    private FemboyMusic() {}
+
+    private static final int RECENT_MOST = 50;
+
+    /** Номер плейлиста «Понравившиеся». */
+    public static final long LIKED = -2;
+
+    public static final String TG = "tg";
+    public static final String SC = "sc";
