@@ -0,0 +1,228 @@
+package org.telegram.ui;
+
+import android.view.View;
+
+import org.telegram.femboy.FemboyConfig;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.femboy.FemboyUpdate;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.R;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+/**
+ * Ветка «Обновления»: как часто спрашивать про новую версию и кнопка спросить
+ * прямо сейчас.
+ *
+ * Раньше проверка была ровно одна — при запуске приложения. Для того, кто
+ * держит телеграм открытым сутками, это значило «никогда».
+ */
+public class FemboyUpdatesActivity extends UniversalFragment {
+
+    /** Кнопка и заголовок не должны попасть в номера значений интервала. */
+    private static final int ID_CHECK_NOW = 1000;
+
+    @Override
+    protected CharSequence getTitle() {
+        return LocaleController.getString(R.string.FemboySecAbout);
+    }
+
+    @Override
+    public View createView(android.content.Context context) {
+        final View view = super.createView(context);
+        listView.setSections();
+        return view;
+    }
+
+    /** Название интервала: «3 минуты», «6 часов», «Никогда». */
+    static String name(int minutes) {
+        if (minutes <= 0) {
+            return LocaleController.getString(R.string.FemboyUpdatesOff);
+        }
+        if (minutes < 60) {
+            return LocaleController.formatPluralString("Minutes", minutes);
+        }
+        return LocaleController.formatPluralString("Hours", minutes / 60);
+    }
+
+    private static final int ID_INTERVAL = 1001;
+    private static final int ID_CHANNEL = 1002;
+    private static final int ID_FORUM = 1003;
+    private static final int ID_FEEDBACK = 1004;
+    private static final int ID_STICKERS = 1005;
+    private static final int ID_SOURCE = 1006;
+    private static final int ID_SOUND = 1007;
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(FemboyRowCell.Factory.of(ID_CHECK_NOW, R.drawable.femboy_ic_mobile_arrow_down,
+                LocaleController.getString(R.string.FemboyUpdatesNow),
+                LocaleController.formatString(R.string.FemboyUpdatesInstalled, FemboyConfig.shownVersion(), BuildVars.BUILD_VERSION_STRING)));
+        items.add(FemboyRowCell.Factory.of(ID_INTERVAL, R.drawable.femboy_ic_restart_alt,
+                LocaleController.getString(R.string.FemboyUpdatesAuto), name(FemboyConfig.updateIntervalMinutes())));
+        items.add(UItem.asShadow(null));
+
+        items.add(FemboyRowCell.Factory.of(ID_CHANNEL, R.drawable.femboy_ic_campaign, LocaleController.getString(R.string.FemboyChannel), "t.me/femboygm"));
+        items.add(FemboyRowCell.Factory.of(ID_FORUM, R.drawable.femboy_ic_forum, LocaleController.getString(R.string.FemboyForum), "t.me/femboyconfs"));
+        items.add(FemboyRowCell.Factory.of(ID_FEEDBACK, R.drawable.femboy_ic_feedback, LocaleController.getString(R.string.FemboyFeedback), LocaleController.getString(R.string.FemboyFeedbackShort)));
+        items.add(FemboyRowCell.Factory.of(ID_STICKERS, R.drawable.femboy_ic_sticky_note_2, LocaleController.getString(R.string.FemboyGramStickers), LocaleController.getString(R.string.FemboyStickersShort)));
+        items.add(FemboyRowCell.Factory.of(ID_SOURCE, R.drawable.femboy_ic_code, LocaleController.getString(R.string.FemboySource), "github.com/webrch/femboy-gram"));
+        // «Звук» появляется, только когда мяуканье уже услышали
+        if (FemboyConfig.meowHeard()) {
+            items.add(FemboyRowCell.Factory.of(ID_SOUND, R.drawable.femboy_ic_pets, LocaleController.getString(R.string.FemboyChime), LocaleController.getString(R.string.FemboySoundInfo)));
+        }
+        items.add(UItem.asShadow(null));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        switch (item.id) {
+            case ID_CHECK_NOW:
+                checkNow();
+                break;
+            case ID_INTERVAL:
+                chooseInterval();
+                break;
+            case ID_CHANNEL:
+                org.telegram.messenger.browser.Browser.openUrl(getContext(), FemboyConfig.CHANNEL_URL);
+                break;
+            case ID_FORUM:
+                org.telegram.messenger.browser.Browser.openUrl(getContext(), FemboyConfig.FORUM_URL);
+                break;
+            case ID_FEEDBACK:
+                org.telegram.messenger.browser.Browser.openUrl(getContext(), FemboyConfig.FEEDBACK_URL);
+                break;
+            case ID_STICKERS:
+                org.telegram.ui.Components.BulletinFactory.of(this).createSimpleBulletin(org.telegram.messenger.R.raw.info, "скоро..").show();
+                break;
+            case ID_SOURCE:
+                org.telegram.messenger.browser.Browser.openUrl(getContext(), FemboyConfig.SOURCE_URL);
+                break;
+            case ID_SOUND:
+                presentFragment(new FemboySoundActivity());
+                break;
+        }
+    }
+
+    /** Как часто искать новую версию: выбор из списка, а не шесть строк на экране. */
+    private void chooseInterval() {
+        final int[] values = FemboyConfig.UPDATE_INTERVALS;
+        final CharSequence[] names = new CharSequence[values.length];
+        for (int i = 0; i < values.length; i++) {
+            names[i] = name(values[i]);
+        }
+        new AlertDialog.Builder(getContext())
+                .setTitle(LocaleController.getString(R.string.FemboyUpdatesAuto))
+                .setItems(names, (d, which) -> {
+                    FemboyConfig.setUpdateIntervalMinutes(values[which]);
+                    // расписание переставляется сразу, без перезапуска
+                    FemboyUpdate.schedule();
+                    listView.adapter.update(true);
+                })
+                .show();
+    }
+
+    /**
+     * Проверка по кнопке работает и при выключенныхавтоматических проверках: человек
+     * попросил — значит спрашиваем.
+     */
+    private void checkNow() {
+        // Проверяем разом и версию, и значки: для человека это одно действие.
+        FemboyUpdate.checkAll(() -> {
+            if (getContext() == null) {
+                return;
+            }
+            final FemboyUpdate.Info info = FemboyUpdate.available();
+            if (info != null) {
+                NotificationCenter.getGlobalInstance()
+                        .postNotificationName(NotificationCenter.appUpdateAvailable);
+                offer(info);
+            } else {
+                BulletinFactory.of(this).createSimpleBulletin(R.raw.chats_infotip,
+                        LocaleController.getString(R.string.FemboyUpdatesLatest)).show();
+            }
+        });
+    }
+
+    /**
+     * Окно с найденной версией и кнопкой, которая её ставит.
+     *
+     * Раньше здесь была подсказка внизу экрана: «вышла версия новее» — и всё.
+     * Человек нажал «проверить», узнал, что обновление есть, и остался с этим
+     * знанием наедине: ни скачать, ни поставить отсюда было нельзя. Сообщать
+     * о работе, которую сам же и не даёшь сделать, — худший вид вежливости.
+     */
+    private void offer(FemboyUpdate.Info info) {
+        final StringBuilder text = new StringBuilder();
+        final String about = info.about();
+        if (about != null && about.length() > 0) {
+            text.append(about);
+        }
+        final AlertDialog.Builder builder = new AlertDialog.Builder(getContext())
+                .setTitle(LocaleController.formatString(R.string.FemboyUpdatesFound, info.label()))
+                .setMessage(text.length() > 0 ? text.toString()
+                        : LocaleController.getString(R.string.FemboyUpdatesAbout))
+                .setNegativeButton(LocaleController.getString(R.string.FemboyLater), null);
+        if (FemboyUpdate.downloaded() != null) {
+            // Уже скачано — второй раз качать незачем.
+            builder.setPositiveButton(LocaleController.getString(R.string.FemboyUpdatesInstall),
+                    (d, w) -> FemboyUpdate.install(getParentActivity()));
+        } else {
+            builder.setPositiveButton(LocaleController.getString(R.string.FemboyUpdatesDownload),
+                    (d, w) -> startDownload());
+        }
+        builder.show();
+    }
+
+    /**
+     * Качает и показывает, сколько уже. Без этого длинная закачка выглядит
+     * так же, как ничего не происходящее нажатие.
+     */
+    private void startDownload() {
+        final AlertDialog progress = new AlertDialog(getContext(), AlertDialog.ALERT_TYPE_LOADING);
+        progress.setCanCancel(true);
+        progress.setOnCancelListener(d -> FemboyUpdate.cancel());
+        progress.show();
+        FemboyUpdate.download(() -> {
+            if (FemboyUpdate.downloading()) {
+                return;
+            }
+            progress.dismiss();
+            if (getContext() == null) {
+                return;
+            }
+            if (FemboyUpdate.downloaded() != null) {
+                FemboyUpdate.install(getParentActivity());
+            } else {
+                BulletinFactory.of(this).createSimpleBulletin(R.raw.error,
+                        LocaleController.getString(R.string.FemboyUpdatesFailed)).show();
+            }
+        });
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+
+    // Как экраны самого телеграма: рисуемся под полоской жестов, а список
+    // получает снизу отступ на её высоту, вместо пустой полосы под ним.
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+
+    @Override
+    public void onInsets(int left, int top, int right, int bottom) {
+        if (listView != null) {
+            listView.setPadding(listView.getPaddingLeft(), listView.getPaddingTop(), listView.getPaddingRight(), bottom);
+            listView.setClipToPadding(false);
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/FemboyWallActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/FemboyWallActivity.java
new file mode 100644
index 00000000..d85bcc60
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/FemboyWallActivity.java
@@ -0,0 +1,114 @@
+package org.telegram.ui;
+
+import android.os.Bundle;
+
+import org.telegram.femboy.FemboyGroup;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+
+/**
+ * Стена: что о человеке написали другие.
+ *
+ * Дуров стену убрал, здесь она возвращается — и не как страница, которую
+ * хозяин правит под себя. Смысл ровно в обратном: написанное про тебя ты
+ * снять не можешь. Поэтому стена и работает против разводил — обманутый
+ * пишет, обманщик не стирает, а видят все.
+ *
+ * Это обычный экран переписки, у которого убрано всё, кроме сообщений с
+ * меткой этой стены. Не похожий на него, не собранный из его деталей и не
+ * его режим поиска — он сам. Отбор стоит внутри {@link ChatActivity}, на
+ * входе списка сообщений; всё остальное — список, поле ввода, меню
+ * сообщения, реакции — работает ровно так же, как в любой переписке.
+ *
+ * Дошло до этого с четвёртого раза. Сначала свои карточки, потом чужие
+ * ячейки на своём экране, потом чужой экран с включённым поиском, который не
+ * отбирает сообщения, а подсвечивает их, потом экран результатов поиска —
+ * список строчек вместо переписки. Каждый раз это выглядело работой, и
+ * каждый раз владелец видел подделку раньше меня. Он же и сказал, как надо:
+ * взять стандартный чат и изменить его.
+ */
+public class FemboyWallActivity extends ChatActivity {
+
+    private final long peerId;
+    private final String peerName;
+
+    private FemboyWallActivity(Bundle args, long peerId, String peerName) {
+        super(args);
+        this.peerId = peerId;
+        this.peerName = peerName == null ? "" : peerName;
+    }
+
+    /**
+     * Открыть чью-то стену.
+     *
+     * Через статический метод, а не через конструктор: адрес группы сперва
+     * надо выяснить, а это поездка на сервер. Конструктор, умеющий ждать,
+     * обманывает вызывающего — он вернёт экран, который ещё не знает, что
+     * показывать.
+     */
+    public static void open(BaseFragment from, long peerId, String peerName) {
+        if (from == null || peerId == 0) {
+            return;
+        }
+        FemboyGroup.resolve(dialogId -> {
+            if (dialogId == 0) {
+                BulletinFactory.of(from).createSimpleBulletin(R.raw.error,
+                        LocaleController.getString(R.string.FemboyGroupUnreachable)).show();
+                return;
+            }
+            final Bundle args = new Bundle();
+            // Группа приходит номером переписки — со знаком минус и приставкой
+            // канала; ChatActivity ждёт голый номер чата.
+            args.putLong("chat_id", -dialogId);
+            args.putString("femboyWallTag", FemboyGroup.tagWall(peerId));
+            args.putString("femboyWallName", peerName == null ? "" : peerName);
+            args.putLong("femboyWallPeer", peerId);
+            final FemboyWallActivity wall = new FemboyWallActivity(args, peerId, peerName);
+            // Сначала ищем помеченное поиском по группе и отдаём стене готовым:
+            // так она открывается сразу с записями, а не с пустым экраном, пока
+            // дочитывает группу. Не нашлось — открываем как есть, стена дочитает.
+            FemboyGroup.find(FemboyGroup.tagWall(peerId), 100, (found, problem) ->
+                    AndroidUtilities.runOnUIThread(() -> {
+                        if (problem == null) {
+                            wall.femboyFound(found);
+                        }
+                        from.presentFragment(wall);
+                    }));
+        });
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        if (!super.onFragmentCreate()) {
+            return false;
+        }
+        // Пока экран открыт, отправка дописывает метку сама. Человек пишет в
+        // обычное поле обычной переписки и про метки ничего не знает — знать
+        // ему и незачем, это наша служебная разметка, а не его забота.
+        FemboyGroup.writingTo(peerId);
+        return true;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        FemboyGroup.writingTo(peerId);
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        // Ушли с экрана — метку больше не дописываем. Иначе она уехала бы в
+        // соседнюю переписку вместе со следующим же сообщением.
+        FemboyGroup.writingTo(0);
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        FemboyGroup.writingTo(0);
+        super.onFragmentDestroy();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/FemboyWavySeekBar.java b/TMessagesProj/src/main/java/org/telegram/ui/FemboyWavySeekBar.java
new file mode 100644
index 00000000..9502de83
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/FemboyWavySeekBar.java
@@ -0,0 +1,254 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.os.SystemClock;
+import android.text.TextPaint;
+import android.view.MotionEvent;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+
+import org.telegram.messenger.AndroidUtilities;
+
+/**
+ * Перемотка в духе MD3 Expressive: пройденная часть идёт волной, которая
+ * бежит, пока играет, и выпрямляется на паузе. Остаток ровный, в конце
+ * точка-ограничитель, бегунок круглый. Время рисуем тут же, под дорожкой.
+ */
+public class FemboyWavySeekBar extends View {
+
+    public interface Listener {
+        void onSeekStart();
+
+        /** Палец ещё едет: показать время, но не перематывать. */
+        void onSeekMove(float progress);
+
+        void onSeekEnd(float progress);
+    }
+
+    private static final float WAVE_LENGTH_DP = 36;
+    private static final float AMPLITUDE_DP = 3.2f;
+    // один период волны в секунду с небольшим: спокойно, но заметно
+    private static final float WAVE_PERIOD_MS = 1300;
+    private static final float AMP_ANIM_MS = 350;
+
+    private final Paint activePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint inactivePaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint thumbPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final TextPaint timePaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final Path wave = new Path();
+
+    private Listener listener;
+    private float progress;
+    private float dragProgress;
+    private boolean dragging;
+    private long durationMs;
+    private boolean playing;
+
+    private float amplitude;
+    private float phase;
+    private float thumbScale = 1f;
+    private long lastFrame;
+
+    public FemboyWavySeekBar(Context context) {
+        super(context);
+        activePaint.setStyle(Paint.Style.STROKE);
+        activePaint.setStrokeCap(Paint.Cap.ROUND);
+        activePaint.setStrokeJoin(Paint.Join.ROUND);
+        activePaint.setStrokeWidth(dp(4));
+        inactivePaint.setStyle(Paint.Style.STROKE);
+        inactivePaint.setStrokeCap(Paint.Cap.ROUND);
+        inactivePaint.setStrokeWidth(dp(4));
+        timePaint.setTextSize(dp(12));
+        timePaint.setFontFeatureSettings("tnum");
+        setColors(0xff6750a4, 0xffe8def8, 0xff49454f);
+    }
+
+    public void setListener(Listener listener) {
+        this.listener = listener;
+    }
+
+    public void setColors(int active, int inactive, int text) {
+        activePaint.setColor(active);
+        thumbPaint.setColor(active);
+        inactivePaint.setColor(inactive);
+        timePaint.setColor(text);
+        invalidate();
+    }
+
+    public void setDuration(long ms) {
+        if (durationMs == ms) return;
+        durationMs = Math.max(0, ms);
+        invalidate();
+    }
+
+    public void setProgress(float value) {
+        value = clamp(value);
+        if (value == progress) return;
+        progress = value;
+        if (!dragging) invalidate();
+    }
+
+    public float getProgress() {
+        return dragging ? dragProgress : progress;
+    }
+
+    public boolean isDragging() {
+        return dragging;
+    }
+
+    public void setPlaying(boolean playing) {
+        if (this.playing == playing) return;
+        this.playing = playing;
+        lastFrame = 0;
+        invalidate();
+    }
+
+    private static float clamp(float v) {
+        return Math.max(0f, Math.min(1f, v));
+    }
+
+    private float trackLeft() {
+        return dp(10);
+    }
+
+    private float trackRight() {
+        return getWidth() - dp(10);
+    }
+
+    private float trackY() {
+        return dp(16);
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(dp(54), MeasureSpec.EXACTLY));
+    }
+
+    @Override
+    protected void onDraw(@NonNull Canvas canvas) {
+        final long now = SystemClock.elapsedRealtime();
+        final float dt = lastFrame == 0 ? 0 : Math.min(64, now - lastFrame);
+        lastFrame = now;
+
+        // волна гаснет на паузе и пока человек тянет бегунок
+        final float targetAmp = playing && !dragging ? 1f : 0f;
+        if (amplitude < targetAmp) amplitude = Math.min(targetAmp, amplitude + dt / AMP_ANIM_MS);
+        else if (amplitude > targetAmp) amplitude = Math.max(targetAmp, amplitude - dt / AMP_ANIM_MS);
+        if (amplitude > 0) phase = (phase + (float) (2 * Math.PI) * dt / WAVE_PERIOD_MS) % (float) (2 * Math.PI);
+        final float targetThumb = dragging ? 1.35f : 1f;
+        if (thumbScale != targetThumb) {
+            final float step = dt / 150f * 0.35f;
+            thumbScale = thumbScale < targetThumb ? Math.min(targetThumb, thumbScale + step) : Math.max(targetThumb, thumbScale - step);
+        }
+
+        final float left = trackLeft(), right = trackRight(), cy = trackY();
+        final float p = dragging ? dragProgress : progress;
+        final float x = left + (right - left) * p;
+        final float thumbR = dp(7) * thumbScale;
+        final float gap = dp(4);
+
+        // пройденное: волной или прямой
+        final float activeEnd = x - thumbR - gap;
+        if (activeEnd > left) {
+            if (amplitude <= 0.01f) {
+                canvas.drawLine(left, cy, activeEnd, cy, activePaint);
+            } else {
+                final float length = dp(WAVE_LENGTH_DP);
+                final float amp = dp(AMPLITUDE_DP) * amplitude;
+                final float ramp = length / 2f;
+                final float step = Math.max(1, dp(1.5f));
+                wave.rewind();
+                for (float xi = left; ; xi += step) {
+                    final float cx = Math.min(xi, activeEnd);
+                    // у краёв волна мягко сходит в ноль, чтобы не обрываться на гребне
+                    final float env = Math.min(1f, Math.min((cx - left) / ramp, (activeEnd - cx) / ramp));
+                    final float y = cy + amp * Math.max(0, env) * (float) Math.sin(2 * Math.PI * (cx - left) / length - phase);
+                    if (cx == left) wave.moveTo(cx, y);
+                    else wave.lineTo(cx, y);
+                    if (cx >= activeEnd) break;
+                }
+                canvas.drawPath(wave, activePaint);
+            }
+        }
+
+        // остаток и точка в конце
+        final float inactiveStart = x + thumbR + gap;
+        if (inactiveStart < right) {
+            canvas.drawLine(inactiveStart, cy, right, cy, inactivePaint);
+        }
+        if (right - x > thumbR + dp(6)) {
+            canvas.drawCircle(right, cy, dp(2), thumbPaint);
+        }
+        canvas.drawCircle(x, cy, thumbR, thumbPaint);
+
+        // время
+        if (durationMs > 0) {
+            final long at = (long) (p * durationMs);
+            final String nowText = AndroidUtilities.formatShortDuration((int) (at / 1000));
+            final String leftText = "-" + AndroidUtilities.formatShortDuration((int) (Math.max(0, durationMs - at) / 1000));
+            final float baseline = getHeight() - dp(6);
+            canvas.drawText(nowText, left - dp(2), baseline, timePaint);
+            canvas.drawText(leftText, right + dp(2) - timePaint.measureText(leftText), baseline, timePaint);
+        }
+
+        if (amplitude > 0 || amplitude != targetAmp || thumbScale != targetThumb) {
+            if (isAttachedToWindow() && getVisibility() == VISIBLE) postInvalidateOnAnimation();
+        } else {
+            lastFrame = 0;
+        }
+    }
+
+    private float fromX(float x) {
+        final float left = trackLeft(), right = trackRight();
+        return clamp((x - left) / Math.max(1, right - left));
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean onTouchEvent(MotionEvent ev) {
+        switch (ev.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
+                dragging = true;
+                dragProgress = fromX(ev.getX());
+                lastFrame = 0;
+                if (listener != null) listener.onSeekStart();
+                if (listener != null) listener.onSeekMove(dragProgress);
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (!dragging) return false;
+                dragProgress = fromX(ev.getX());
+                if (listener != null) listener.onSeekMove(dragProgress);
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (!dragging) return false;
+                dragProgress = fromX(ev.getX());
+                progress = dragProgress;
+                dragging = false;
+                if (listener != null) listener.onSeekEnd(progress);
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                dragging = false;
+                invalidate();
+                return true;
+        }
+        return false;
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        lastFrame = 0;
+        invalidate();
+    }
+}
