+def get_queue_by_name(name):
+    """Очередь телеграма по имени. Своей очереди плагинов у телеграма нет, заводим."""
+    name = str(name)
+    try:
+        очередь = getattr(_Utilities, name)
+        if очередь is not None:
+            return очередь
+    except Exception:
+        pass
+    with _замок:
+        очередь = _свои_очереди.get(name)
+        if очередь is None:
