@@ -0,0 +1,63 @@
+package com.exteragram.messenger.plugins.xposed;
+
+import com.chaquo.python.PyObject;
+import com.exteragram.messenger.plugins.PluginsConstants;
+import com.exteragram.messenger.plugins.PluginsController;
+
+import org.telegram.femboy.FemboyPluginHost;
+
+import java.lang.reflect.InvocationTargetException;
+
+import de.robv.android.xposed.XC_MethodReplacement;
+import de.robv.android.xposed.XposedBridge;
+
+/** Подмена метода целиком: питоновский replace_hooked_method вместо оригинала. */
+public class PyMethodReplacement extends XC_MethodReplacement implements AutoCloseable {
+
+    private final String pluginId;
+    private final PyObject replace;
+    private volatile boolean disabled;
+
+    public PyMethodReplacement(String pluginId, PyObject callback) {
+        super();
+        this.pluginId = pluginId;
+        this.replace = need(callback);
+    }
+
+    public PyMethodReplacement(String pluginId, PyObject callback, int priority) {
+        super(priority);
+        this.pluginId = pluginId;
+        this.replace = need(callback);
+    }
+
+    private static PyObject need(PyObject callback) {
+        if (callback == null) throw new IllegalArgumentException("Python callback object cannot be null");
+        if (!callback.containsKey(PluginsConstants.Xposed.REPLACE_HOOKED_METHOD)) {
+            throw new IllegalArgumentException("Python callback object must contain a method named 'replace_hooked_method'");
+        }
+        return callback.get(PluginsConstants.Xposed.REPLACE_HOOKED_METHOD);
+    }
+
+    @Override
+    protected Object replaceHookedMethod(MethodHookParam param) throws Throwable {
+        if (disabled || !PluginsController.getInstance().isPluginActive(pluginId)) {
+            try {
+                return XposedBridge.invokeOriginalMethod(param.method, param.thisObject, param.args);
+            } catch (InvocationTargetException e) {
+                throw e.getTargetException() != null ? e.getTargetException() : e;
+            }
+        }
+        try {
+            PyObject result = replace.call(param);
+            return result == null ? null : result.toJava(Object.class);
+        } catch (Throwable t) {
+            FemboyPluginHost.log(pluginId, "replace_hooked_method: " + t, true);
+            return null;
+        }
+    }
+
+    @Override
+    public void close() {
+        disabled = true;
+    }
+}
diff --git a/TMessagesProj_AppStandalone/src/main/java/org/telegram/femboy/FemboyMusicPython.java b/TMessagesProj_AppStandalone/src/main/java/org/telegram/femboy/FemboyMusicPython.java
new file mode 100644
index 00000000..a3be472a
--- /dev/null
+++ b/TMessagesProj_AppStandalone/src/main/java/org/telegram/femboy/FemboyMusicPython.java
@@ -0,0 +1,64 @@
+package org.telegram.femboy;
+
+import com.chaquo.python.PyObject;
+import com.chaquo.python.Python;
+import com.chaquo.python.android.AndroidPlatform;
+
+import org.telegram.messenger.ApplicationLoader;
+
+import java.io.File;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Мост к femboy_music_online.py: поиск и скачивание музыки через yt-dlp.
+ *
+ * Общая библиотека зовёт этот класс по имени, через отражение (FemboyMusicOnline),
+ * потому что питон есть только в этой сборке. Все вызовы долгие: только не
+ * с главного потока. Ответ каждого метода — строка JSON.
+ */
+public class FemboyMusicPython {
+
+    private static PyObject module;
+
+    private static synchronized PyObject module() {
+        if (module == null) {
+            if (!Python.isStarted()) {
+                try {
+                    Python.start(new AndroidPlatform(ApplicationLoader.applicationContext));
+                } catch (IllegalStateException alreadyStarted) {
+                    // плагины успели запустить питон с главного потока
+                }
+            }
+            final PyObject one = Python.getInstance().getModule("femboy_music_online");
+            final File cache = new File(ApplicationLoader.applicationContext.getCacheDir(), "yt-dlp");
+            one.callAttr("init", cache.getAbsolutePath());
+            module = one;
+        }
+        return module;
+    }
+
+    private static String text(PyObject answer) {
+        return answer == null ? null : answer.toString();
+    }
+
+    public static String search(String source, String query, int limit) {
+        return text(module().callAttr("search", source, query, limit));
+    }
+
+    public static String related(String source, String id, String url, int limit) {
+        return text(module().callAttr("related", source, id, url, limit));
+    }
+
+    public static String recommend(String seeds, int limit) {
+        return text(module().callAttr("recommend", seeds, limit));
+    }
+
+    /** outPath без расширения: питон допишет своё. progress: 0..1000. */
+    public static String download(String source, String id, String url, String outPath, AtomicInteger progress) {
+        return text(module().callAttr("download", source, id, url, outPath, progress));
+    }
+
+    public static String version() {
+        return text(module().callAttr("version"));
+    }
+}
